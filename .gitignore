# Ignore all files in target/ directory
/target/

# But, allow specific files within the target/ directory (i.e., JAR files)
!target/*.jar

!.mvn/wrapper/maven-wrapper.jar

# Ignore IDE project files
### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/

# Ignore logs, OS-specific files
*.log
*.swp
.DS_Store
Thumbs.db
